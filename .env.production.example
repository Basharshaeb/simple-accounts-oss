# Copy to .env on the SERVER (not committed to git) at DEPLOY_PATH.
# docker-compose.yml reads this via env_file + --env-file.

APP_NAME="Simple Accounts"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://accounts.example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simple_accounts
DB_USERNAME=simple_accounts
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

